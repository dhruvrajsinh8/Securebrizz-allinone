# Copy to .env and fill in. Never commit a real .env.

# ── Database (required) ──────────────────────────────────────────────────────
# Postgres, not SQLite. Get both strings from neon.tech → your project → Connect.
# Paste only the connection string itself — not the surrounding `psql '...'`
# command Neon shows you.
# DATABASE_URL = pooled connection (host contains "-pooler")
# DIRECT_URL   = direct connection (same database, host WITHOUT "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# ── Auth (required in production) ────────────────────────────────────────────
# Signs session cookies. At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET=

# ── Scanner ──────────────────────────────────────────────────────────────────
# Lets you scan localhost during development. Keep false in production.
ALLOW_LOCAL_SCAN=false

# Optional overrides for the seed account password and scan rate limits.
# SEED_PASSWORD=
# SCAN_LIMIT_USER=10
# SCAN_LIMIT_WINDOW_MINUTES=10
# SCAN_LIMIT_USER_DAILY=100
# SCAN_LIMIT_IP=20

# ── Email (optional in dev, required in production for real delivery) ─────────
# Resend API key from resend.com. If omitted, emails are logged to the dev console.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="SecureBiz Security <onboarding@resend.dev>"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
