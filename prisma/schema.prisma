// Postgres, not SQLite: Vercel's filesystem is read-only and per-invocation
// ephemeral. `url` is the POOLED connection (used at runtime); `directUrl` is
// the DIRECT connection (used only by prisma migrate).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             String
  avatar           String?
  company          String?
  plan             String
  createdAt        DateTime  @default(now())
  lastLogin        DateTime?
  twoFactorEnabled Boolean   @default(false)
  status           String    @default("active")
  emailVerified    Boolean   @default(false)
  sessions         Session[]
}

/// One row per signed-in device. The session cookie carries this row's id, so
/// deleting a row revokes that device immediately — without it, "sign out this
/// device" would be cosmetic while the signed token stayed valid.
model Session {
  id         String   @id @default(uuid())
  device     String
  browser    String
  location   String
  ip         String
  lastActive DateTime @default(now())
  /// Defaulted so the column could be added to existing rows; every session
  /// created from now on sets it explicitly. Pre-existing rows therefore read
  /// as already expired, which is correct — they were never bound to a token.
  expiresAt  DateTime @default(now())
  isCurrent  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActive])
}

// Vulnerabilities are created from real scan findings, scoped per user.
model Vulnerability {
  id             String    @id @default(uuid())
  title          String
  description    String
  severity       String
  status         String
  cveId          String?
  cvssScore      Float?
  affectedAsset  String
  discoveredAt   DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  category       String
  tags           String
  recommendation String
  references     String
  assignee       String?
  effort         String
  impact         String

  findingId   String?
  target      String?
  lastScanId  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  evidence    String?
  userId      String?

  @@unique([userId, target, findingId])
  @@index([status, severity])
  @@index([userId])
}

model ScanResult {
  id                 String   @id @default(uuid())
  url                String
  scanDate           DateTime @default(now())
  duration           Int
  overallScore       Int
  riskScore          Int
  dnsSecEnabled      Boolean
  httpsEnabled       Boolean
  hasRobotsTxt       Boolean
  hasSecurityTxt     Boolean
  mixedContent       Boolean
  weakPasswordPolicy Boolean
  directoryListing   Boolean
  serverInfo         String?
  aiSummary          String
  ssl                String
  securityHeaders    String
  openPorts          String
  technologies       String
  cookieAnalysis     String
  outdatedLibraries  String
  adminPagesExposed  String
  subdomains         String?
  recommendations    String

  grade                String?
  durationMs           Int?
  finalUrl             String?
  httpStatus           Int?
  cms                  String?
  redirectChain        String?
  checks               String?
  dns                  String?
  content              String?
  scoreBreakdown       String?
  emailSecurity        String?
  subresourceIntegrity String?
  phishing             String?
  userId               String?

  @@index([userId, scanDate])
}

// One row per scan attempt: the rate-limit counter and the abuse audit trail.
model ScanAudit {
  id        String   @id @default(uuid())
  userId    String?
  ip        String
  target    String
  createdAt DateTime @default(now())
  outcome   String   @default("started")

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

/// Failed and successful sign-in attempts, used to throttle credential guessing.
/// Rows are keyed by both email and IP so one attacker cannot lock out a victim
/// by burning their email quota from many addresses, and vice versa.
model AuthAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// One-time token emailed to verify a new account's email address.
model EmailVerifyToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hex of the raw token
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([userId])
  @@index([token])
}

/// One-time token emailed for password reset. Keyed on email so it
/// survives if the user changes their email before using it.
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   // stored as SHA-256 hex of the raw token
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
}
